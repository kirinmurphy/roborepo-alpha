{
  "path": ["plans", "archive"],
  "kind": "internal",
  "title": "Archive plan",
  "description": "Record why a plan was retired and commit its move to archived without losing unmerged work",
  "usage": "roborepo plans archive <plan> --reason <text> [--base <branch>] [--json]",
  "execution": {
    "adapter": "module",
    "module": "scripts/cli/plans.mjs",
    "export": "plansCommand",
    "prependArgs": ["archive"]
  }
}
