{
  "path": ["plans", "show"],
  "kind": "internal",
  "title": "Show a plan",
  "description": "Print a plan from the plans worktree, refreshing from the remote unless --local is set",
  "usage": "roborepo plans show <plan> [--local] [--json]",
  "execution": {
    "adapter": "module",
    "module": "scripts/cli/plans-command.mjs",
    "export": "plansCommand",
    "prependArgs": ["show"]
  }
}
