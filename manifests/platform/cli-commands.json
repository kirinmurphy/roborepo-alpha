{
  "schemaVersion": 2,
  "commandName": "roborepo",
  "title": "RoboRepo",
  "helpLabels": {
    "usage": "Usage:",
    "openMenu": "Open the interactive menu",
    "openNamespaceMenu": "Open that namespace's menu",
    "openThisMenu": "Open this menu",
    "runDirect": "Run a command directly",
    "primaryCommands": "Primary commands:",
    "commands": "Commands:",
    "namespaces": "Namespaces:",
    "scopedHelpHint": "Run `roborepo help <namespace>` for scoped help.",
    "deeperHelpHint": "Run `roborepo help {path} <name>` for deeper help."
  },
  "navigation": [
    { "kind": "header", "label": "Navigation" },
    { "action": "help", "label": "Help", "description": "Show scoped help" },
    { "action": "back", "label": "Back", "description": "Return to parent menu" },
    { "action": "exit", "label": "Exit", "description": "Quit" }
  ],
  "executionPresets": {
    "packageCommand": {
      "adapter": "module",
      "module": "scripts/cli/packages.mjs",
      "export": "packageCommand"
    },
    "packageLibrary": {
      "adapter": "module",
      "module": "scripts/cli/presets.mjs",
      "export": "presetsCommand",
      "prependArgs": ["onboard"]
    },
    "telemetryCommand": {
      "adapter": "module",
      "module": "scripts/cli/telemetry.mjs",
      "export": "telemetryCommand",
      "argv": "tokensTail",
      "tailFrom": 1
    },
    "configCommand": {
      "adapter": "module",
      "module": "scripts/cli/config.mjs",
      "export": "configCommand"
    },
    "workspaceCommand": {
      "adapter": "module",
      "module": "scripts/cli/workspace.mjs"
    }
  },
  "commandDefinitionRoots": ["manifests/platform/cli/command-definitions"],
  "repoScripts": {
    "skill sync-global": { "runtime": "bash", "path": "scripts/build/link-global-skills.sh" },
    "skill render-commands": { "runtime": "node", "path": "scripts/build/render-slash-commands.mjs", "requiresDevelopmentCheckout": true },
    "update": { "runtime": "bash", "path": "scripts/install/main.sh" },
    "repair": { "runtime": "bash", "path": "scripts/install/repair.sh" },
    "uninstall": { "runtime": "bash", "path": "scripts/install/uninstall.sh" },
    "harness-withdraw": { "runtime": "bash", "path": "scripts/install/withdraw.sh" },
    "doctor": { "runtime": "bash", "path": "scripts/doctor.sh" },
    "verify": { "runtime": "bash", "path": "scripts/verify-install.sh" },
    "rules": { "runtime": "bash", "path": "scripts/build/render-rules.sh", "requiresDevelopmentCheckout": true },
    "permissions": { "runtime": "node", "path": "scripts/build/render-agent-permissions.mjs", "requiresDevelopmentCheckout": true }
  }
}
