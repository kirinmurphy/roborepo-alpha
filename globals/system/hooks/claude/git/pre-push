#!/bin/sh
# Refuses agent pushes to a protected branch, then runs the repo's own pre-push hook. Git passes the
# exact destination refs on stdin, so this catches pushes the PreToolUse check could not parse.
# Protected: main, master, the remote's default branch, and ROBOREPO_PROTECTED_BRANCHES (comma-separated).

. "$(dirname "$0")/chain.sh"

remote=$1
protected="main master $(printf '%s' "${ROBOREPO_PROTECTED_BRANCHES:-}" | tr ',' ' ')"
remote_head=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null)
[ -n "$remote_head" ] && protected="$protected ${remote_head#"$remote"/}"

input=$(cat)
blocked=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  branch=${remote_ref#refs/heads/}
  [ "$branch" = "$remote_ref" ] && continue
  for name in $protected; do
    [ "$branch" = "$name" ] && blocked="$blocked $branch"
  done
done <<EOF
$input
EOF

if [ -n "$blocked" ]; then
  echo "roborepo: pushing to protected branch(es):$blocked is blocked for agents. Push a feature branch and open a pull request instead." >&2
  exit 1
fi

printf '%s\n' "$input" | roborepo_chain_hook pre-push "$@"
