{
  "$schema": "../../../scripts/harnesses/provider-manifest.schema.json",
  "schemaVersion": 1,
  "id": "codex",
  "displayName": "Codex",
  "commandName": "codex",
  "adapter": "codex",
  "detection": {
    "executables": ["codex"],
    "executableValidation": { "args": ["--version"] },
    "homeCandidates": ["~/.codex"],
    "configCandidates": ["~/.codex/config.toml"],
    "minimumConfidence": "confirmed"
  },
  "platforms": {
    "darwin": {
      "detection": {
        "desktopCandidates": [{
          "label": "Codex",
          "roots": ["/Applications", "~/Applications"],
          "layouts": [["ChatGPT.app"]],
          "bundleId": "com.openai.codex",
          "executable": "Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex"
        }, {
          "label": "Codex",
          "roots": ["/Applications", "~/Applications"],
          "layouts": [["ChatGPT.app"]],
          "bundleId": "com.openai.codex",
          "executable": "Contents/Resources/codex"
        }]
      }
    }
  },
  "paths": {
    "home": { "path": "~/.codex", "kind": "directory" },
    "rootConfig": { "path": "~/.codex/config.toml", "kind": "file" },
    "rules": { "path": "~/.codex/AGENTS.md", "kind": "file" },
    "rulesOverride": { "path": "~/.codex/AGENTS.override.md", "kind": "file" },
    "skills": { "path": "~/.codex/skills", "kind": "directory" },
    "commands": { "path": "~/.codex/commands", "kind": "directory" },
    "hooks": { "path": "~/.codex/hooks.json", "kind": "file" }
  },
  "capabilities": [
    "root-config",
    "rules",
    "permissions",
    "skills",
    "slash-commands",
    "hooks",
    "mcp",
    "package-config",
    "telemetry-capture",
    "telemetry-rate-limits",
    "telemetry-transcripts",
    "session-launch"
  ],
  "extensions": {
    "app": {
      "headlessPromptArgs": ["exec", "--skip-git-repo-check", "--", "{prompt}"],
      "rootConfigFormat": "toml",
      "hooksStorage": "dedicated-json-sidecar",
      "mcpStorage": "toml-mcp_servers-table",
      "perCommandAsk": false,
      "perCommandAskNote": "Codex has no per-command ask tier. Items set to ask fall through to Codex's approval_policy instead of prompting individually."
    }
  }
}
