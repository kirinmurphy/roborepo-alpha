{
  "$schema": "../../../scripts/harnesses/provider-manifest.schema.json",
  "schemaVersion": 1,
  "id": "claude",
  "displayName": "Claude Code",
  "commandName": "claude",
  "adapter": "claude",
  "detection": {
    "executables": ["claude"],
    "executableValidation": { "args": ["--version"] },
    "homeCandidates": ["~/.claude"],
    "configCandidates": ["~/.claude/settings.json"],
    "minimumConfidence": "confirmed"
  },
  "platforms": {
    "darwin": {
      "detection": {
        "desktopCandidates": [{
          "label": "Claude Code",
          "roots": ["~/Library/Application Support/Claude/claude-code"],
          "layouts": [["*", "claude.app"], ["*", "*", "claude.app"]],
          "bundleId": "com.anthropic.claude-code",
          "executable": "Contents/MacOS/claude",
          "verifiedMarker": ".verified",
          "parentApp": {
            "label": "Claude Desktop",
            "roots": ["/Applications", "~/Applications"],
            "bundle": "Claude.app",
            "bundleId": "com.anthropic.claudefordesktop",
            "setupHint": "Open Claude Desktop’s Code tab to install Claude Code"
          }
        }]
      }
    }
  },
  "paths": {
    "home": { "path": "~/.claude", "kind": "directory" },
    "rootConfig": { "path": "~/.claude/settings.json", "kind": "file" },
    "rules": { "path": "~/.claude/CLAUDE.md", "kind": "file" },
    "skills": { "path": "~/.claude/skills", "kind": "directory" },
    "commands": { "path": "~/.claude/commands", "kind": "directory" },
    "mcpLiveStore": { "path": "~/.claude.json", "kind": "file" }
  },
  "capabilities": [
    "root-config",
    "rules",
    "permissions",
    "skills",
    "slash-commands",
    "hooks",
    "mcp",
    "package-config",
    "telemetry-capture",
    "telemetry-transcripts",
    "session-launch"
  ],
  "extensions": {
    "app": {
      "rootConfigFormat": "json",
      "hooksStorage": "embedded-in-root-config",
      "mcpStorage": "native-cli-and-sidecar-json"
    }
  }
}
