{
  "schemaVersion": 1,
  "id": "jdocmunch",
  "label": "Doc Indexing (with JDocMunch)",
  "description": "Local docs index with section search, TOC, and context retrieval. Routes doc exploration through jdocmunch tools instead of reading full files.",
  "lifecycle": "optional",
  "capabilities": ["doc-lookup"],
  "presentation": {
    "category": "token-optimization",
    "order": 30
  },
  "urls": [
    {
      "label": "PyPI",
      "url": "https://pypi.org/project/jdocmunch-mcp/"
    }
  ],
  "resources": [
    {
      "type": "mcp",
      "preset": "jdocmunch"
    },
    {
      "type": "cli-command",
      "name": "index docs",
      "commandOrUrl": "uvx",
      "args": ["jdocmunch-mcp", "index-local", "--path"],
      "mode": "target"
    },
    {
      "type": "rules",
      "source": "rules.md",
      "harness": "claude"
    },
    {
      "type": "hooks",
      "source": "hooks-claude.json",
      "harness": "claude"
    },
    {
      "type": "hooks",
      "source": "hooks-codex.json",
      "harness": "codex"
    },
    {
      "type": "codex_tool_approvals",
      "server": "jdocmunch",
      "approvals": {
        "index_local": "approve",
        "index_repo": "approve",
        "delete_index": "approve",
        "list_repos": "auto",
        "get_toc": "approve",
        "get_toc_tree": "auto",
        "get_document_outline": "auto",
        "search_sections": "approve",
        "get_section": "approve",
        "get_sections": "approve",
        "get_section_context": "approve",
        "get_broken_links": "auto",
        "get_doc_coverage": "auto",
        "doc_list_repos": "approve",
        "list_repo_groups": "approve",
        "list_docs": "approve"
      }
    }
  ]
}
