{
  "schemaVersion": 1,
  "id": "usage-statusline",
  "label": "Usage Statusline",
  "description": "Shows context and rate-limit usage in supported harness footers, and context usage above the prompt in the Claude desktop app, without model calls.",
  "lifecycle": "optional",
  "presentation": {
    "category": "token-optimization",
    "order": 10
  },
  "resources": [
    {
      "type": "package-runtime-asset",
      "source": "scripts/claude-statusline.mjs"
    },
    {
      "type": "package-runtime-asset",
      "source": "claude/context-row/lib/usage-adapters.mjs"
    },
    {
      "type": "package-runtime-asset",
      "source": "claude/context-row/lib/usage-domain.mjs"
    },
    {
      "type": "package-runtime-asset",
      "source": "claude/context-row/lib/usage-render.mjs"
    },
    {
      "type": "package-runtime-asset",
      "source": "scripts/usage-snapshot-store.mjs"
    },
    {
      "type": "package-runtime-asset",
      "source": "claude/context-row"
    },
    {
      "type": "config-patch",
      "harness": "claude",
      "label": "status line",
      "patches": [
        {
          "op": "set",
          "path": [
            "statusLine"
          ],
          "value": {
            "type": "command",
            "command": "node \"${package-runtime:claude-statusline.mjs}\"",
            "padding": 1
          }
        }
      ]
    },
    {
      "type": "config-patch",
      "harness": "claude",
      "label": "desktop context row plugin folder",
      "patches": [
        {
          "op": "union",
          "path": [
            "env",
            "CLAUDE_CODE_PLUGIN_DIRS"
          ],
          "value": [
            "${package-runtime:context-row}"
          ],
          "delimiter": "path"
        }
      ]
    },
    {
      "type": "config-patch",
      "harness": "codex",
      "label": "status line",
      "patches": [
        {
          "op": "union",
          "path": [
            "tui",
            "status_line"
          ],
          "value": [
            "model-with-reasoning",
            "context-remaining",
            "five-hour-limit",
            "weekly-limit",
            "git-branch"
          ]
        }
      ]
    }
  ],
  "defaultEnabled": false
}
