{
  "schemaVersion": 1,
  "id": "caveman",
  "label": "Caveman plugin",
  "description": "Claude plugin that keeps agent output terse to cut token use. Also gates the global caveman communication rule.",
  "lifecycle": "optional",
  "presentation": {
    "category": "token-optimization",
    "order": 40
  },
  "urls": [
    {
      "label": "GitHub",
      "url": "https://github.com/JuliusBrussee/caveman"
    }
  ],
  "resources": [
    {
      "type": "rules",
      "source": "rules.md"
    },
    {
      "type": "config-patch",
      "harness": "claude",
      "label": "Caveman plugin",
      "patches": [
        {
          "op": "set",
          "path": [
            "extraKnownMarketplaces",
            "caveman"
          ],
          "value": {
            "source": {
              "source": "github",
              "repo": "JuliusBrussee/caveman"
            }
          }
        },
        {
          "op": "set",
          "path": [
            "enabledPlugins",
            "caveman@caveman"
          ],
          "value": true
        }
      ]
    },
    {
      "type": "hooks",
      "source": "hooks-codex.json",
      "harness": "codex"
    }
  ]
}
