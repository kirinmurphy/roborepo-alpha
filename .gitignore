.DS_Store

# Never commit agent runtime state or credentials.
**/auth.json
**/history.jsonl
**/*.sqlite
**/*.sqlite-*
**/sessions/
**/logs/
**/log/
**/cache/
**/.cache/
**/tmp/
**/.tmp/
**/shell_snapshots/
**/shell-snapshots/
**/paste-cache/
**/file-history/
**/stats-cache.json
**/mcp-needs-auth-cache.json
**/settings.local.json
**/installation_id
**/models_cache.json
**/state_*.sqlite*
**/logs_*.sqlite*
**/plugins/installed_plugins.json
**/plugins/known_marketplaces.json
**/scheduled_tasks.lock

# Local backup output from install script.
.backups/

# devDependency install (Playwright test tooling) — never committed; the shipped npm package
# stays zero-dependency via the files whitelist + no `dependencies` field. No trailing slash: a
# linked worktree may symlink node_modules to the primary checkout's, and `node_modules/` only
# matches a directory.
node_modules

# Playwright output (portal-ui browser suite) — last-run state + failure screenshots.
test-results/

# Skill export bundles produced by `harness_helper --export-skill` (shareable artifacts,
# not source). Pattern guards against accidentally committing a test/export run.
global_agent_skills_*.zip

# jdocmunch index marker written into indexed dirs. Normally covered by ~/.gitignore_global, but
# uninstall removes that entry — ignore it here too so the marker never shows up as untracked.
.jdm-indexed
**/.jdm-indexed
