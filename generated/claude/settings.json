      "Bash(roborepo version:*)",
      "Bash(roborepo plans validate:*)",
      "Bash(roborepo plans repair:*)",
      "Bash(roborepo package list:*)",
      "Bash(roborepo package inspect:*)",
      "Bash(roborepo package status:*)",
      "Bash(roborepo package validate:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test:*)",
      "Bash(pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(go test:*)",
      "Bash(cargo test:*)",
      "Bash(./scripts/doctor.sh:*)",
      "Bash(./scripts/verify-install.sh:*)",
      "Bash(./scripts/install/main.sh --dry-run:*)",
      "Bash(npm run skills:compile:*)",
      "Bash(npm run skills:validate:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:preview:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run check:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next lint:*)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/Library/Keychains/**)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(git checkout -B main:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(gh auth token:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git rm:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(roborepo update:*)",
      "Bash(roborepo maintenance:*)",
      "Bash(roborepo mcp:*)",
      "Bash(roborepo package enable:*)",
      "Bash(roborepo package disable:*)",
      "Bash(roborepo package reconcile:*)",
      "Bash(roborepo package adopt-live:*)",
      "Bash(roborepo package manage:*)",
      "Bash(roborepo package dev:*)",
      "Bash(roborepo skill:*)",
      "Bash(roborepo config:*)",
      "Bash(roborepo harness:*)",
      "Bash(roborepo apply:*)",
      "Bash(roborepo permissions:*)",
      "Bash(roborepo rules:*)",
      "Bash(roborepo setup:*)",
      "Bash(roborepo workspace:*)",
      "Bash(roborepo presets:*)",
      "Bash(roborepo bundle:*)",
      "Bash(roborepo experimental:*)",
      "Bash(roborepo onboard-intro:*)",
      "Bash(roborepo init:*)",
      "Bash(roborepo dev:*)",
      "Bash(roborepo library:*)",
      "Bash(roborepo uninstall:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "count=0; for d in \"${HOME}/.codex/skills\"/*/; do name=\"$(basename \"${d%/}\")\"; case \"${name}\" in .*) continue;; esac; [ -L \"${d%/}\" ] || count=$((count+1)); done; for d in \"${HOME}/.claude/skills\"/*/; do name=\"$(basename \"${d%/}\")\"; case \"${name}\" in .*) continue;; esac; [ -L \"${d%/}\" ] || count=$((count+1)); done; [ \"${count}\" -gt 0 ] && echo \"{\\\"systemMessage\\\": \\\"unmanaged skills: ${count} — run 'roborepo skill adopt <name>' to version-control\\\"}\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "_comment": "Denies pushes that land on a protected branch (main, master, the remote's default), so git push itself can be allowed. See globals/system/hooks/claude/protected-branch-push.mjs.",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/protected-branch-push.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/minimize-bash-output.mjs\""
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/provider/repo-write-scope.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/write-guard.mjs\""
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": false,
  "awaySummaryEnabled": false,
  "env": {
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.hooksPath",
    "GIT_CONFIG_VALUE_0": "~/.claude/git-hooks"
  }
}
